# =========================================================
# Environment & secrets
# =========================================================
# Service-account / Firebase Admin SDK private key
private-key.json
*-private-key.json
*service-account*.json
*Service_Account*.json
*firebase-adminsdk*.json
# Warn: a Service_Account_Key.json was present in early commits.
# It is now gitignored. If it still exists on disk, delete it and
# rotate the key — it should NOT live inside the project tree.
Service_Account_Key.json
# Local .env with real secrets — DO NOT commit. Use .env.example as template.
/.env
.env.local
.env.*.local
# Broader .env coverage (non-.local variants)
.env.development
.env.production
.env.staging
# Generic secrets
*.pem
*.key
*.crt
*.p12
# Log files (any language)
*.log

# =========================================================
# Go build artifacts
# =========================================================
# VS Code Go tools output directory (e.g. from go-coverage, gotests)
__debug_bin*
# Compiled binaries
/server.exe
/server
/server-linux-amd64
/server.out
/server.err
/server.exe~
*.exe
*.exe~
*.dll
*.so
*.dylib
# Standard Go layout output dirs (if/when adopted)
bin/
dist/
# Scratch / experiment folders
tmp/
scratch/
# Test binaries / coverage
*.test
*.test.exe
*.out
coverage.html
coverage.txt
# Default names produced by `go test -coverprofile=` and friends
coverage.out
c.out
*.cover
coverage.xml
# CPU / mem / block / mutex / trace profiles from `go test -.*profile`
*.prof
*.trace
# Native Go 1.20+ integration coverage dir (GOCOVERDIR)
gocover/
# Go workspace
go.work
go.work.sum
# Vendoring — ignored by default (modules managed by go mod).
# If you need reproducible builds (e.g. Cloud Run), remove this line
# and commit the vendor/ directory instead.
vendor/

# =========================================================
# IDE & editor
# =========================================================
.idea/
*.iml
*.swp
*.swo
*~
# VS Code — ignore everything inside .vscode/ EXCEPT extensions.json
# so that recommended extensions propagate to all devs.
.vscode/*
!.vscode/extensions.json
# Patch / merge backups
*.bak
*.orig
*.rej
# Per-developer Makefile overrides (e.g. PORT, BIN overrides)
Makefile.local
# direnv / nix-shell local env overrides
.envrc
.direnv/
# Developer-specific start scripts
start_*.ps1
start_*.sh
# Internal project planning / spec notes
spec-notes.txt

# =========================================================
# Dependencies (web-ui)
# =========================================================
node_modules/

# =========================================================
# OS files
# =========================================================
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# =========================================================
# End of .gitignore
# =========================================================
# Logs & runtime
# =========================================================
*.log
logs/
# VS Code Copilot / agent debug logs
debug-logs/
