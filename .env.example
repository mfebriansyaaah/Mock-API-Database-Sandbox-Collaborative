# Copy this file to `.env` and fill in real values for local development.
# .env is listed in .gitignore and must NEVER be committed.

# Google Cloud / Firebase configuration
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
# Prefer absolute path outside project tree, e.g.:
# GOOGLE_APPLICATION_CREDENTIALS="C:\secrets\your-service-account.json"
# Or use gcloud auth (no file needed):
#   gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS="path/to/your-service-account.json"

# Server configuration
PORT="8080"

# Application environment: "development" (default) or "production"
# Controls CORS behaviour, log verbosity, and error detail level.
APP_ENV="development"

# Logger configuration (optional - has sensible defaults)
LOG_CHANNEL_BUFFER="1000"
LOG_NUM_WORKERS="10"
LOG_CLEANUP_INTERVAL="5m"
LOG_MAX_LOGS_PER_PROJECT="100"
